// GitHub: https://github.com/NooberPro/minecraft-discord-bot
// Crowdin: https://crowdin.com/project/minecraft-discord-bot
// English Translation (en) by NooberPro

{
  // Translation for the slash commands.

  // The name field is the command name. You can rename the command name, but it CANNOT BE TRANSLATED.
  // The description field provides the description of the command.
  help: {
    name: 'help',
    description: 'Sends the list of available commands.',
    options: {
      name: 'command',
      description: 'Sends the details about a command.',
    },
  },
  ip: {
    name: 'ip',
    description: 'Sends the server address of the Minecraft server.',
  },
  site: {
    name: 'site',
    description: 'Sends the website/vote link of the Minecraft server.',
  },
  version: {
    name: 'version',
    description: 'Sends the version of the Minecraft server.',
  },

  // The errorReply field is used if there is an error while executing the command, and it replies with an errorReply message.
  motd: {
    name: 'motd',
    description: "Sends the Minecraft Server's Message of the Day (MOTD).",
    errorReply: ':warning:  **`An error occurred while retrieving the Message of the Day (MOTD).`**',
  },
  players: {
    name: 'players',
    description: 'Sends the list of players who are currently online on the Minecraft server.',
    errorReply: ':warning:  **`An error occurred while retrieving the online players list.`**',
  },
  status: {
    name: 'status',
    description: 'Sends the current status of the Minecraft server.',
    errorReply: ':warning:  **`Unable to find the status of the server due to an error.`**',
  },
  info: {
    name: 'info',
    description: 'Sends the current information about the bot.',
    errorReply: ':warning:  **`An error occurred while retrieving Info.`**',
  },
  setstatus: {
    name: 'setstatus',
    description: 'Sets the status message of the Minecraft server in the current channel.',
    serverName: 'Enter the name of your Minecraft server.',
    serverIp: 'Enter the IP address of your Minecraft server.',
    serverPort: 'Enter the port number of your Minecraft server.',
    serverType: 'Choose your server type: Java or Bedrock',
    // Use {error} to receive the error message.
    errorReply: ':warning:  **`Could not set the status message due to an error: {error}.`**',
    enableFeature: '**Please enable `auto Change Status` in the config to enable the status message feature.**',
    checkingStatusMsg: ':gear: Checking the status...',
    checkingStatusCmdMsg: ':arrows_clockwise: Checking the status and necessary info.',
    // Use {channel} to provide the channel link, and {messageLink} provides the message link icon.
    statusMsgSuccess: ':white_check_mark: **Status message is set successfully in {channel}. Message:** {messageLink}.',
  },
  // Whitelist request command. {username} is the player's whitelist name and {edition} is Java or Bedrock.
  whitelist: {
    name: 'whitelist',
    description: 'Request or manage access to the Minecraft server whitelist.',
    request: {
      name: 'request',
      description: 'Request to be added to the Minecraft server whitelist.',
      username: 'Your Minecraft username. Bedrock players: your Xbox gamertag.',
      edition: 'The Minecraft edition you play on.',
    },
    list: {
      name: 'list',
      description: 'Shows all whitelisted players. Staff only.',
    },
    remove: {
      name: 'remove',
      description: 'Removes a player from the whitelist. Staff only.',
      username: 'The whitelist entry to remove, eg: EdenZyn or .Connor_Leo2299',
    },
    replies: {
      invalidJava: ':warning: **`{username}` is not a valid Java username. Use 3-16 letters, numbers or underscores.**',
      invalidBedrock: ':warning: **`{username}` is not a valid Bedrock gamertag. Use up to 16 letters, numbers or spaces.**',
      alreadyWhitelisted: ':white_check_mark: **{username}** is already whitelisted. You can join the server.',
      alreadyPending: ':hourglass: You already have a pending request for **{username}**. Please wait for staff to review it.',
      namePending: ':hourglass: A request for **{username}** is already waiting for review.',
      submitted: ':white_check_mark: Your request for **{username}** ({edition}) was sent to staff. You will get a DM once it is reviewed.',
      error: ':warning: **`Something went wrong while handling the whitelist request. Please try again later.`**',
      notStaff: ':no_entry: Only staff can review whitelist requests.',
      notFound: ':warning: This whitelist request no longer exists.',
      // {status} is the current status of the request.
      alreadyHandled: ':information_source: This request was already reviewed: {status}.',
      inProgress: ':hourglass: Another staff member is already handling this request.',
      // {error} is the reason the player could not be whitelisted.
      approveFailed: ':warning: **Could not whitelist {username}:** {error}',
      notVerified: 'The command was sent, but {username} did not appear in the whitelist. Check the name or the server console.',
      // {user} mentions the player.
      dmFailed: ':warning: {user} could not be notified because their DMs are closed.',
      listEmpty: ':information_source: The whitelist is empty.',
      panelError: ':warning: **`Could not reach the server panel. Please try again later.`**',
      removeNotFound: ':warning: **`{username}` is not on the whitelist.**',
      // {staff} mentions the staff member who removed the player.
      removed: ':white_check_mark: **{username}** ({edition}) was removed from the whitelist by {staff}.',
      removeFailed: ':warning: **Could not remove {username}:** {error}',
      removeAmbiguous: ':warning: **Several whitelist entries match `{username}` with different capitalisation. Remove it from the server console instead.**',
      removeNotVerified: 'The command was sent, but {username} is still on the whitelist. Check the server console.',
    },
    embeds: {
      requestTitle: 'Whitelist Request',
      discordUser: 'Discord User',
      edition: 'Edition',
      username: 'Username',
      whitelistName: 'Whitelist Entry',
      status: 'Status',
      reason: 'Reason',
      noReason: 'No reason given.',
      playerNotified: 'Player Notified',
      pending: ':hourglass: Pending',
      processing: ':gear: Adding to whitelist...',
      // {staff} mentions the staff member who made the decision.
      approved: ':white_check_mark: Approved by {staff}',
      rejected: ':x: Rejected by {staff}',
      approveButton: 'Approve',
      rejectButton: 'Reject',
      rejectModalTitle: 'Reject Whitelist Request',
      rejectReasonLabel: 'Reason (sent to the player)',
      // {username} is the player's whitelist name and {server} is the Minecraft server name.
      dmApprovedTitle: 'Whitelist Request Approved',
      dmApprovedDescription: 'Your request for **{username}** on **{server}** was approved. You can join the server now!',
      dmRejectedTitle: 'Whitelist Request Rejected',
      dmRejectedDescription: 'Your request for **{username}** on **{server}** was rejected.',
      logTitle: 'Whitelist Decision',
      // {count} is the number of entries.
      listTitle: 'Whitelisted Players ({count})',
      listMore: '...and {count} more',
      logRemovalTitle: 'Whitelist Removal',
      removedBy: 'Removed By',
    },
  },
  serverinfo: {
    name: 'serverinfo',
    description: 'Sends the Java and Bedrock addresses and info of the Minecraft server.',
    errorReply: ':warning:  **`An error occurred while sending the server info.`**',
  },
  disabledChannelMsg: ':no_entry: Commands are disabled in this channel.',
}
