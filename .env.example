# Copy this file to .env and fill in the values. Never commit .env.

# Discord bot token from https://discord.com/developers/applications
BOT_TOKEN=your-bot-token-here

# Hosting panel (Pterodactyl / Reviactyl), used by the whitelist and the status message uptime.
# Panel URL without a trailing slash.
PTERO_PANEL_URL=https://gp.hector.host
# Short server ID from the panel URL, eg: https://gp.hector.host/server/b0b9a9bf -> b0b9a9bf
PTERO_SERVER_ID=your-server-id
# Client API key from Account > API Credentials. Preferably from a subuser with console access only.
PTERO_API_KEY=your-client-api-key
