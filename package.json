{
  "name": "razzz-smp-bot",
  "version": "2.0.0",
  "description": "Discord bot for the RazzZ SMP Minecraft server: live status, server info and whitelist requests.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "discord:minecraft": "tsx src/scripts/setupMinecraftSection.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RazzZ-Official/minecraft-discord-bot.git"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "node-mcstatus": "^1.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
